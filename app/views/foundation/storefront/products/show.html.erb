<% title @product.name %>
<turbo-frame id="product-detail">
  <section class="md-section pm-detail" aria-labelledby="pm-detail-title">
    <div class="md-section__inner">
      <div class="pm-detail__head">
        <%= link_to storefront_products_path, class: "md-button md-button--text" do %>
          <span aria-hidden="true">&larr;</span> Back to feed
        <% end %>
      </div>
      <div class="pm-detail__layout">
        <div class="pm-detail__image"><%= storefront_product_image(@product, alt: @product.name, class_name: "pm-detail__img") %></div>
        <div class="md-stack pm-detail__info">
          <div>
            <p class="md-section__eyebrow"><%= @product.set_name.presence || "Available" %> &middot; <%= @product.card_number.presence || "—" %></p>
            <h1 id="pm-detail-title"><%= @product.name %></h1>
          </div>
          <% if @product.rarity.present? %><p class="pm-chip pm-chip--lg"><%= @product.rarity %></p><% end %>
          <p><%= simple_format(@product.description, {}, wrapper_tag: "span") %></p>
          <strong class="storefront-price pm-detail__price"><%= storefront_money(@product.price_cents, @product.currency) %></strong>
          <%= form_with url: items_storefront_cart_path(@product), class: "md-stack pm-detail__form" do |form| %>
            <div class="md-field">
              <%= form.label :quantity, "Quantity" %>
              <%= form.number_field :quantity, value: 1, min: 1, max: [10, @product.inventory_quantity].min, required: true, inputmode: "numeric" %>
              <p class="md-field__support">Maximum 10 per item.</p>
            </div>
            <%= form.submit "Add to cart", class: "md-button md-button--filled" %>
          <% end %>
          <%= link_to "View cart", storefront_cart_path, class: "md-button md-button--tonal" %>
        </div>
      </div>
    </div>
  </section>
</turbo-frame>
